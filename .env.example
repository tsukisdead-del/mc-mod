# Copy this file to .env for local use. On a hosting service, set these as environment variables instead.

# Required: your Claude API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required: a private code you type once on your phone to unlock the app (like a password).
ACCESS_CODE=

# Optional: where chats, memory and uploads are stored. Point this at a persistent disk when hosting.
# DATA_DIR=./data

# Optional: the app's public https address. Detected automatically on Render and Railway.
# PUBLIC_URL=https://your-app.example.com

# Optional: which Claude model to use and how hard it thinks (low | medium | high).
# CLAUDE_MODEL=claude-opus-5-5
# CHAT_EFFORT=medium

# Optional: fixed push-notification keys (generated and saved in DATA_DIR automatically if unset).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Optional: try the app with canned replies and no API key.
# MOCK_AI=1
